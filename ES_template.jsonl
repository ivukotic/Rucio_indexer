PUT _index_template/rucio-nongrid-traces
{
  "template": {
    "aliases": {
      "rucio-nongrid-traces": {}
    },
    "mappings": {
      "properties": {
        "containers_accessed": {
          "type": "keyword"
        },
        "timeentry": {
          "format": "epoch_second",
          "index": true,
          "ignore_malformed": false,
          "store": false,
          "type": "date",
          "doc_values": true
        },
        "ip": {
          "type": "ip"
        },
        "@version": {
          "type": "keyword"
        },
        "files": {
          "type": "text"
        },
        "ReportRate": {
          "type": "float"
        },
        "branches_accessed": {
          "eager_global_ordinals": false,
          "norms": false,
          "index": true,
          "store": false,
          "type": "keyword",
          "index_options": "docs",
          "split_queries_on_whitespace": false,
          "doc_values": true
        },
        "ROOT_RELEASE": {
          "type": "keyword"
        }
      }
    },
    "settings": {
      "index": {
        "mapping": {
          "total_fields": {
            "limit": "10000"
          }
        }
      }
    }
  },
  "index_patterns": [
    "rucio-nongrid-traces-*"
  ],
  "composed_of": [],
  "ignore_missing_component_templates": []
}

